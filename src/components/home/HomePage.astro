---
/**
 * HomePage — renders the homepage from the locale JSON `home` namespace.
 *
 * Data-driven: changing src/locales/en.json updates the homepage without
 * touching this component.
 *
 * Sections (top to bottom):
 *   1. Hero          — title, description, CTAs (strong visual anchor)
 *   2. QuickStart    — 4 large icon cards (Codes / Bosses / Guides / Tier)
 *   3. Recent Updates + Trending links (two columns)
 *   4. Explore       — 4 content modules with displayTypes
 *   5. ClosingCta      — bottom call-to-action
 *
 * v0.2 refactor: trimmed from 8 sections to 5. Removed GameInfo (info
 * duplicated Hero stats), FAQ (moved to /faq), standalone TrendingNow
 * (merged into Recent Updates). Explore modules trimmed 8→4. Page length
 * compressed from ~7 screens to ~4.
 */
import { Icon } from 'astro-icon/components';
import LocaleLayout from '~/components/layout/LocaleLayout.astro';
import VideoSection from '~/components/home/VideoSection.astro';
import QuickStart from '~/components/home/QuickStart.astro';
import ExpeditionStatus from '~/components/home/ExpeditionStatus.astro';
import ExploreModules from '~/components/home/ExploreModules.astro';
import { site } from '~/config/site';
import { NAVIGATION_CONFIG, NAV_BY_KEY } from '~/config/navigation';
import { type Locale } from '~/i18n/routing';
import { getUi } from '~/i18n/ui';
import { getRecentEntries, parseEntryId, getAllEntriesByCategory } from '~/lib/content';
import { categoryHue, starField } from '~/lib/categoryTheme';
import { localizePath, listPath, detailPath } from '~/lib/url';

interface Props {
  locale: Locale;
  jsonLd?: Record<string, unknown>[];
  /** hreflang alternates (built by the route page). */
  alternates?: Array<{ hreflang: string; href: string }>;
}
const { locale, jsonLd = [], alternates = [] } = Astro.props;
const ui = getUi(locale);
const home = ui.home as any;
const shared = ui.shared as unknown as Record<string, any>;
const navLabels = ui.nav as Record<string, string>;

const recent = await getRecentEntries(locale, 6);

// Total published guides across all categories — feeds the hero stats bar
// ("value": "dynamic" slot), so the number grows with the wiki automatically.
const perCategoryCounts = await Promise.all(
  NAVIGATION_CONFIG.map((n) => getAllEntriesByCategory(n.key).then((es) => es.length)),
);
const totalGuides = perCategoryCounts.reduce((a, b) => a + b, 0);

// Hero star layers — two independent fields twinkling out of phase so the
// sky reads as having depth. Fixed seeds = stable HTML across builds.
const heroStarsA = starField('hero/a', 34);
const heroStarsB = starField('hero/b', 22);

const meta = home.meta ?? { title: site.name, description: site.description };
const hero = home.hero ?? {};
const updates = home.updates ?? { title: 'Recent Updates' };
const expeditionStatus = home.expeditionStatus ?? {};
const start = home.start ?? { cards: [] };
const popular = home.popular ?? { title: 'Trending Now', quickLinks: [] };
const explore = home.explore ?? { modules: [] };
const closingCta = home.closingCta ?? {};

// QuickLink may be a string or { label, href } — normalize for the sidebar list.
type QuickLink = string | { label: string; href: string };
const trendingLinks: QuickLink[] = Array.isArray(popular.quickLinks) ? popular.quickLinks : [];
function trendingHref(link: QuickLink): string | null {
  return typeof link === 'string' ? null : localizePath(link.href, locale);
}
function trendingLabel(link: QuickLink): string {
  return typeof link === 'string' ? link : link.label;
}

// CTA hrefs from locale JSON may be internal paths or absolute URLs —
// only internal paths get the locale prefix.
function linkHref(href: string): string {
  return href.startsWith('/') ? localizePath(href, locale) : href;
}
---

<LocaleLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  alternates={alternates}
  jsonLd={jsonLd}
>
  {/* ─────────────────────────────── Hero ───────────────────────────────
      Deep-space scene, intentionally dark in BOTH themes — the hero IS the
      game's setting, so it reads as a poster block above the themed page.
      Every element is original CSS geometry (gradients + borders): no image
      assets, no runtime JS. */}
  <section
    class="relative flex min-h-[60vh] flex-col overflow-hidden border-b border-border bg-[hsl(231_48%_6%)] text-white md:min-h-[72vh]"
  >
    {/* Base: nebula glows over a deep-space gradient. */}
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0"
      style="background:
        radial-gradient(110% 85% at 80% 10%, hsl(265 60% 32% / 0.38), transparent 62%),
        radial-gradient(90% 70% at 8% 92%, hsl(15 81% 45% / 0.2), transparent 65%),
        linear-gradient(180deg, hsl(232 50% 9%), hsl(231 48% 5%));"
    >
    </div>

    {/* Two star fields, twinkling out of phase. */}
    <div
      aria-hidden="true"
      class="stars-twinkle pointer-events-none absolute inset-0"
      style={`background-image:${heroStarsA.image};animation-duration:${heroStarsA.duration};`}
    >
    </div>
    <div
      aria-hidden="true"
      class="stars-twinkle pointer-events-none absolute inset-0"
      style={`background-image:${heroStarsB.image};animation-duration:${heroStarsB.duration};animation-delay:1.3s;`}
    >
    </div>

    {/* Ringed planet — brand-orange gas giant with a small moon. Hidden on
        the narrowest viewports where the type needs the full width. */}
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -right-[7%] top-[9%] hidden w-[36vw] min-w-[280px] max-w-[520px] sm:block"
      style="aspect-ratio:1/1;"
    >
      <div
        class="absolute left-1/2 top-1/2 rounded-[50%] border-2"
        style="width:172%;height:46%;transform:translate(-50%,-50%) rotate(-16deg);border-color:hsl(25 65% 62% / 0.38);"
      >
      </div>
      <div
        class="absolute inset-0 rounded-full"
        style="background:radial-gradient(circle at 30% 28%, hsl(28 80% 64%), hsl(18 72% 44%) 52%, hsl(222 50% 12%) 98%);
          box-shadow:0 0 90px hsl(15 81% 50% / 0.4), inset -18px -14px 60px hsl(222 55% 8% / 0.55);"
      >
      </div>
      <div
        class="absolute left-1/2 top-1/2 rounded-[50%] border-2"
        style="width:172%;height:46%;transform:translate(-50%,-50%) rotate(-16deg);border-color:hsl(25 70% 68% / 0.6);clip-path:polygon(-20% 50%, 120% 50%, 120% 130%, -20% 130%);"
      >
      </div>
      <div
        class="absolute rounded-full"
        style="left:4%;top:76%;width:9%;aspect-ratio:1/1;
          background:radial-gradient(circle at 35% 32%, hsl(210 30% 88%), hsl(215 25% 60%) 60%, hsl(220 25% 30%));
          box-shadow:0 0 18px hsl(210 40% 70% / 0.35);"
      >
      </div>
    </div>

    {/* Horizon glow anchoring the section to the content below. */}
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-[hsl(15_81%_45%/0.12)] to-transparent"
    >
    </div>

    <div class="relative flex flex-1 items-center">
      <div class="mx-auto w-full max-w-7xl px-4 py-16 md:py-24">
      <p
        class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-white/90 backdrop-blur-sm"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-[hsl(15_90%_60%)] shadow-[0_0_8px_hsl(15_90%_60%)]"></span>
        {hero.badge}
      </p>
      <h1
        class="mt-4 max-w-3xl bg-gradient-to-r from-white via-white to-white/60 bg-clip-text text-4xl font-black tracking-tight text-transparent drop-shadow-[0_2px_12px_hsl(231_50%_5%/0.8)] sm:text-5xl md:text-6xl lg:text-7xl"
      >
        {hero.title}
      </h1>
      <p class="mt-5 max-w-xl text-base text-white/75 md:text-lg">{hero.description}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        {
          hero.ctaPrimary && (
            <a
              href={linkHref(typeof hero.ctaPrimary === 'string' ? '/cosmos-update' : hero.ctaPrimary.href)}
              class="btn-primary"
            >
              <Icon name="lucide:rocket" class="mr-2 h-4 w-4" />
              {typeof hero.ctaPrimary === 'string' ? hero.ctaPrimary : hero.ctaPrimary.label}
            </a>
          )
        }
        {
          hero.ctaSecondary && (
            <a
              href={linkHref(
                typeof hero.ctaSecondary === 'string'
                  ? listPath(NAVIGATION_CONFIG[1]?.key ?? 'guides', locale)
                  : hero.ctaSecondary.href,
              )}
              class="inline-flex items-center justify-center rounded-md border border-white/25 bg-white/5 px-4 py-2 text-sm font-medium text-white transition hover:bg-white/15"
            >
              {typeof hero.ctaSecondary === 'string' ? hero.ctaSecondary : hero.ctaSecondary.label}
            </a>
          )
        }
      </div>
      </div>

      {/* Stats bar — big-number facts anchoring the hero's bottom edge.
          The "dynamic" slot shows the live guide count. */}
      {
        hero.stats?.length > 0 && (
          <div class="relative border-t border-white/10 bg-black/25">
            <dl class="mx-auto grid max-w-7xl grid-cols-2 gap-x-4 gap-y-5 px-4 py-6 sm:grid-cols-4 md:py-7">
              {hero.stats.map((stat: { value: string; label: string }) => (
                <div>
                  <dt class="text-[11px] font-semibold uppercase tracking-wider text-white/50">
                    {stat.label}
                  </dt>
                  <dd class="mt-1 text-2xl font-black tracking-tight text-white md:text-3xl">
                    {stat.value === 'dynamic' ? totalGuides : stat.value}
                  </dd>
                </div>
              ))}
            </dl>
          </div>
        )
      }
    </section>

  {/* Trailer — only renders when a videoId is configured. */}
  {hero.videoId && <VideoSection videoId={hero.videoId} title={`${site.game.name} trailer`} />}

  {/* ───────────────────────────── Quick Start ────────────────────────── */}
  <QuickStart
    locale={locale}
    badge={start.badge}
    title={start.title}
    cards={start.cards}
  />

  {/* ─────────────────────── Expedition status ────────────────────────── */}
  <ExpeditionStatus
    locale={locale}
    badge={expeditionStatus.badge}
    title={expeditionStatus.title}
    detail={expeditionStatus.detail}
    cta={expeditionStatus.cta}
  />

  {/* ───────────────────── Recent Updates + Trending ───────────────────── */}
  <section class="section border-t border-border">
    <div class="grid gap-8 lg:grid-cols-3">
      {/* Recent updates — 2/3 width on desktop. */}
      <div class="lg:col-span-2">
        <div class="flex items-baseline justify-between">
          <h2 class="text-2xl font-bold">{updates.title}</h2>
          <a href={listPath('guides', locale)} class="text-sm text-foreground hover:text-nav hover:underline"
            >{shared.browseAll}</a
          >
        </div>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          {
            recent.length === 0 ? (
              <p class="text-sm text-muted-foreground">{shared.noArticles}</p>
            ) : (
              recent.map((entry) => {
                const parsed = parseEntryId(entry.id);
                if (!parsed) return null;
                return (
                  <a href={detailPath(parsed.category, parsed.slug, locale)} class="card p-4">
                    <span
                      class="cat-chip"
                      style={`--chip-h:${categoryHue(parsed.category)};`}
                    >
                      <Icon
                        name={NAV_BY_KEY[parsed.category]?.icon ?? 'lucide:book-open'}
                        class="h-3 w-3"
                      />
                      {navLabels[parsed.category] ?? parsed.category}
                    </span>
                    <h3 class="mt-2 font-semibold leading-snug">{entry.data.title}</h3>
                    <p class="mt-1 line-clamp-2 text-sm text-muted-foreground">
                      {entry.data.description}
                    </p>
                  </a>
                );
              })
            )
          }
        </div>
      </div>

      {/* Trending — 1/3 width sidebar list. */}
      {trendingLinks.length > 0 && (
        <aside>
          <p class="text-sm font-semibold uppercase tracking-wider text-foreground">{popular.badge}</p>
          <h2 class="mt-1 text-2xl font-bold">{popular.title}</h2>
          <ul class="mt-4 space-y-2">
            {trendingLinks.map((link: QuickLink) => {
              const href = trendingHref(link);
              const label = trendingLabel(link);
              return (
                <li>
                  {href ? (
                    <a
                      href={href}
                      class="flex items-center gap-2 rounded-md border bg-card p-3 text-sm font-medium transition hover:border-nav/50"
                    >
                      <Icon name="lucide:trending-up" class="h-4 w-4 shrink-0 text-nav" />
                      <span class="leading-snug">{label}</span>
                    </a>
                  ) : (
                    <div class="flex items-center gap-2 rounded-md border bg-card p-3 text-sm font-medium">
                      <Icon name="lucide:trending-up" class="h-4 w-4 shrink-0 text-nav" />
                      <span class="leading-snug">{label}</span>
                    </div>
                  )}
                </li>
              );
            })}
          </ul>
        </aside>
      )}
    </div>
  </section>

  {/* ──────────────────────────── Explore Modules ─────────────────────── */}
  {
    explore.modules?.length > 0 && (
      <section class="section border-t border-border">
        <h2 class="text-2xl font-bold">{explore.title}</h2>
        <p class="mt-1 text-sm text-muted-foreground">{explore.description}</p>
        <div class="mt-8">
          <ExploreModules modules={explore.modules} locale={locale} />
        </div>
      </section>
    )
  }

  {/* ─────────────────────────────── Final CTA ────────────────────────── */}
  {
    closingCta.title && (
      <section class="section border-t border-border">
        <div class="rounded-xl border bg-card p-8 text-center md:p-12">
          <h2 class="text-2xl font-bold md:text-3xl">{closingCta.title}</h2>
          <p class="mx-auto mt-2 max-w-xl text-muted-foreground">{closingCta.description}</p>
          <div class="mt-6 flex justify-center gap-3">
            <a
              href={linkHref(typeof closingCta.primary === 'string' ? '/guides' : closingCta.primary.href)}
              class="btn-primary"
            >
              {typeof closingCta.primary === 'string' ? closingCta.primary : closingCta.primary.label}
            </a>
            {closingCta.secondary && (
              <a
                href={linkHref(typeof closingCta.secondary === 'string' ? '/guides' : closingCta.secondary.href)}
                class="btn-outline"
              >
                {typeof closingCta.secondary === 'string' ? closingCta.secondary : closingCta.secondary.label}
              </a>
            )}
          </div>
        </div>
      </section>
    )
  }
</LocaleLayout>
