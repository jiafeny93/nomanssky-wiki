---
/**
 * AdsterraSlot — renders a single Adsterra banner unit via iframe isolation.
 *
 * Reads the unit key + size from src/config/ads.ts (AD_UNITS). When the
 * position has no entry in AD_UNITS, the component renders nothing —
 * beginners can deploy with no ads configured and the site works fine.
 *
 * The unit loads inside `public/ads/slot.html`, embedded here in a sandboxed
 * iframe. Ad creatives are third-party scripts: without a sandbox they can
 * hijack the top-level page (navigate the whole site to an ad — seen in the
 * wild 2026-08). The sandbox grants exactly what creatives need to render
 * (allow-same-origin: opaque origins crash Adsterra's cookie/localStorage
 * access → blank ads) and never grants allow-top-navigation. Verified combo,
 * same as the other wiki sites.
 */
import { AD_UNITS, AD_SCRIPT_HOST, type AdPosition } from '~/config/ads';

interface Props {
  /** Which configured ad unit to render (see src/config/ads.ts). */
  position: AdPosition;
  /** Optional CSS class for the iframe (e.g. centering). */
  class?: string;
}

const { position, class: className = '' } = Astro.props;
const unit = AD_UNITS[position];
---

{
  unit && (
    <iframe
      src={`/ads/slot.html?key=${unit.key}&w=${unit.width}&h=${unit.height}&host=${encodeURIComponent(AD_SCRIPT_HOST)}`}
      width={unit.width}
      height={unit.height}
      scrolling="no"
      loading="lazy"
      class={className}
      style="border:none; margin:0; padding:0;"
      title={`advertisement ${position}`}
      aria-hidden="true"
      sandbox="allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox allow-forms"></iframe>
  )
}
