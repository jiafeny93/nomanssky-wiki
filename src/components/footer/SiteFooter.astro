---
/**
 * Site footer — social links, legal links, copyright.
 * All text comes from locale JSON (footer.* namespace).
 */
import { Icon } from 'astro-icon/components';
import { site } from '~/config/site';
import { type Locale } from '~/i18n/routing';
import { getUi } from '~/i18n/ui';
import { localizePath, recentPath, tagsPath } from '~/lib/url';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const ui = getUi(locale);
const footer = ui.footer as Record<string, string>;
const shared = ui.shared as unknown as Record<string, any>;

// Discover links — /recent and /tags previously had zero inbound links from
// site chrome (orphan pages: crawlable via sitemap only). The footer column
// makes them first-class crawl paths on every page.
const exploreLinks = [
  { label: shared.recentTitle, href: recentPath(locale) },
  { label: shared.allTags, href: tagsPath(locale) },
  { label: footer.faq, href: localizePath('/faq', locale) },
];

const socials = [
  { key: 'playGame', href: site.social.official, icon: 'lucide:external-link' },
  { key: 'officialDiscord', href: site.social.discord, icon: 'lucide:message-circle' },
  { key: 'officialYoutube', href: site.social.youtube, icon: 'lucide:youtube' },
  { key: 'officialTwitter', href: site.social.twitter, icon: 'lucide:twitter' },
  { key: 'officialReddit', href: site.social.reddit, icon: 'lucide:globe' },
].filter((s) => s.href);

const legalLinks = ['about', 'faq', 'privacyPolicy', 'termsOfService', 'copyright'];
---

<footer class="mt-16 border-t border-border bg-muted/30">
  <div class="mx-auto max-w-7xl px-4 py-10">
    <div class="grid gap-8 sm:grid-cols-2 md:grid-cols-4">
      {/* Brand */}
      <div>
        <div class="flex items-center gap-2 font-bold">
          <Icon name="lucide:hammer" class="h-6 w-6 text-nav" />
          <span>{site.name}</span>
        </div>
        <p class="mt-2 text-sm text-muted-foreground">{site.tagline}</p>
      </div>

      {/* Explore — recent updates / tags / FAQ */}
      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wider text-muted-foreground">
          {shared.explore ?? 'Explore'}
        </h2>
        <ul class="mt-3 space-y-2">
          {
            exploreLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="inline-flex items-center gap-2 text-sm text-foreground/80 transition hover:text-nav"
                >
                  <Icon name="lucide:arrow-right" class="h-4 w-4" />
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      {/* Socials */}
      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wider text-muted-foreground">
          Community
        </h2>
        <ul class="mt-3 space-y-2">
          {
            socials.map((s) => (
              <li>
                <a
                  href={s.href}
                  rel="noopener noreferrer"
                  target="_blank"
                  class="inline-flex items-center gap-2 text-sm text-foreground/80 transition hover:text-nav"
                >
                  <Icon name={s.icon} class="h-4 w-4" />
                  {footer[s.key]}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      {/* Legal */}
      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wider text-muted-foreground">Legal</h2>
        <ul class="mt-3 space-y-2">
          {
            legalLinks.map((key) => (
              <li>
                <a
                  href={localizePath(
                    `/${key === 'privacyPolicy' ? 'privacy-policy' : key === 'termsOfService' ? 'terms-of-service' : key}`,
                    locale,
                  )}
                  class="text-sm text-foreground/80 transition hover:text-nav"
                >
                  {footer[key]}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="mt-8 border-t border-border pt-6">
      <p class="text-xs text-muted-foreground">{footer.copyrightText ?? site.legalNotice}</p>
    </div>
  </div>
</footer>
